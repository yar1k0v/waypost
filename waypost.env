# waypost settings for docker compose. Edit, then run: docker compose up -d --force-recreate
# The index rebuilds by itself when PBF_URLS or WAYPOST_LANGS change.

# Geofabrik extracts, space-separated. Several countries go into one index.
# List: https://download.geofabrik.de/
PBF_URLS=https://download.geofabrik.de/europe/switzerland-latest.osm.pbf

# Name languages to store besides the default `name` tag, comma-separated.
WAYPOST_LANGS=en,de,fr,it

# 1 forces a rebuild, for example to pick up fresh OSM data.
REBUILD=0
